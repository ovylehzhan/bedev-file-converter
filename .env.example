# ===========================================
# Database (PostgreSQL in Docker - free, local)
# ===========================================
POSTGRES_DB=fileconverter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ===========================================
# CloudConvert API
# Get your key at: https://cloudconvert.com/dashboard/api/v2/keys
# Free plan: 25 conversions/day
# ===========================================
CLOUDCONVERT_API_KEY=your_api_key_here
CLOUDCONVERT_SANDBOX=true

# ===========================================
# Rate Limiting
# Max concurrent conversion jobs sent to CloudConvert
# ===========================================
MAX_CONCURRENT_JOBS=30
